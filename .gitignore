# ===== Killer Bot 400 - gitignore =====

# Env + Secrets - IMPORTANT FOR RENDER!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Appstate - NEVER PUSH FB COOKIES!
appstate.json
appstate.txt
fbstate.json
*.state.json

# Bot Data
data.json
data_backup.json
threads.json
users.json
economy.json
database.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Canvas + Build
canvas/build/
build/
dist/
*.node

# Logs
logs/
*.log
pm2.log
bot.log
error.log

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.code-workspace

# Media downloads temp
tmp/
temp/
downloads/
cache/
*.mp4
*.mp3
*.jpg
*.png
!assets/*.png

# Render + Hosting
.render/
