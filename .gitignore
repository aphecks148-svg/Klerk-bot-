node_modules/
.env
.env.*
!.env.example
*.log
appstate.json
.replit
.upm/
.cache/

# bot/data holds the game data the 14 plugins require at load time.
# The bare `data/` pattern above would match it at any depth, so re-include
# it explicitly — if this is ever dropped, the bot fails to start.
!bot/data/
!bot/data/**
